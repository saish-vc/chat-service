# ChatWave server environment variables
# Copy this file to .env and fill in real values.

# Port the Express + Socket.IO server listens on
PORT=4000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/chatwave

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-strong-random-secret

# Frontend origin used for CORS and cookie sameSite/secure settings.
# In production this should be your deployed frontend URL (e.g. https://chatwave.example.com).
CLIENT_URL=http://localhost:5173

# Optional: set to "production" to enable secure cookies and stricter CORS.
NODE_ENV=development
